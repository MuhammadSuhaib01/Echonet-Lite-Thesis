@ARTICLE{phamMatterECHONETLite2024,
  ABSTRACT = {With the increasing number of connected devices in smart homes, ensuring compatibility and interoperability is becoming increasingly more important. Matter and ECHONET Lite have been introduced to tackle this issue. While Matter is gaining significant attention globally as the future protocol for smart homes, ECHONET Lite has a long history of development and adoption in the smart home in Japan. Therefore, it is essential that both Matter and ECHONET Lite devices are interoperable to provide maximum benefits to users. In this paper, we provide an in-depth analysis that compares the architecture and features of Matter and ECHONET Lite, highlighting both their commonalities and differences. On top of that, we introduce a solution to bridge ECHONET Lite devices into the Matter ecosystem, enabling them to collaborate seamlessly with other Matter devices. This bridge solution is developed, implemented, and tested within a real smart home testbed installed with commercial and experimental ECHONET Lite devices. Our results show that the proposed solution effectively enables the smooth integration of ECHONET Lite devices into the Matter ecosystem, making it suitable for everyday use in smart home environments.},
  AUTHOR = {Pham, Van Cu and Nguyen-Mau, Toan and Sioutis, Marios and Tan, Yasuo},
  URL = {https://www.sciencedirect.com/science/article/pii/S2542660524002063},
  DATE = {2024-10-01},
  DOI = {10.1016/j.iot.2024.101265},
  FILE = {C\:\\Users\\laghari\\Zotero\\storage\\K9WBIKMG\\Pham et al. - 2024 - Matter and ECHONET Lite Similarities, differences, and a bridge solution for interoperability.pdf;C\:\\Users\\laghari\\Zotero\\storage\\KYLFN7YR\\S2542660524002063.html},
  ISSN = {2542-6605},
  JOURNALTITLE = {Internet of Things},
  KEYWORDS = {ECHONET Lite,Interoperability,Matter,Matter bridge,Smart homes},
  PAGES = {101265},
  SHORTJOURNAL = {Internet of Things},
  SHORTTITLE = {Matter and {{ECHONET Lite}}},
  TITLE = {Matter and {{ECHONET Lite}}: {{Similarities}}, Differences, and a Bridge Solution for Interoperability},
  URLDATE = {2026-08-24},
  VOLUME = {27},
}

