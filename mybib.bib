  title = {Matter and {{ECHONET Lite}}: {{Similarities}}, Differences, and a Bridge Solution for Interoperability},
  shorttitle = {Matter and {{ECHONET Lite}}},
  author = {Pham, Van Cu and Nguyen-Mau, Toan and Sioutis, Marios and Tan, Yasuo},
  date = {2024-10-01},
  journaltitle = {Internet of Things},
  shortjournal = {Internet of Things},
  volume = {27},
