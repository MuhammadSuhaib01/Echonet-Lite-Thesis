@article{shevchenkoNatureLossesCyberrelated2023,
  title        = {The Nature of Losses from Cyber-Related Events: Risk Categories and Business Sectors},
  shorttitle   = {The Nature of Losses from Cyber-Related Events},
  author       = {Shevchenko, Pavel V and Jang, Jiwook and Malavasi, Matteo and Peters, Gareth W and Sofronov, Georgy and Trück, Stefan},
