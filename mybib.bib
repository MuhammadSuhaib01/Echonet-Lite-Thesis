  author = {Heartfield, Ryan and Loukas, George and Budimir, Sanja and Bezemskij, Anatolij and Fontaine, Johnny R.J. and Filippoupolitis, Avgoustinos and Roesch, Etienne},
  date = {2018-09},
  journaltitle = {Computers \& Security},
  shortjournal = {Computers \& Security},
  volume = {78},
