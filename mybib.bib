@inproceedings{tanakaEvaluationSecureEndtoend2018,
  title = {Evaluation of a Secure End-to-End Remote Control System for Smart Home Appliances},
  booktitle = {2018 {{IEEE International Conference}} on {{Consumer Electronics}} ({{ICCE}})},
  author = {Tanaka, Hisayoshi and Suzuki, Hidekazu and Watanabe, Akira and Naito, Katsuhiro},
