{
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "Visual Studio Light",
  "editor.mouseWheelZoom": true,
  "editor.wordWrap": "on",
  "files.autoSave": "onFocusChange",
  "editor.defaultFormatter": "James-Yu.latex-workshop",
  "editor.formatOnSave": true,

  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%DIR%/build",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "pdflatex",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.linting.chktex.enabled": false,
  "latex-workshop.latex.search.rootFiles.include": [
    "**/usmthesis.tex"
  ],
  "latex-workshop.latex.search.rootFiles.exclude": [
    "**/usmthesis_original.tex",
    "**/usmthesis_original.md",
    "**/build/**",
    "**/extra/**"
  ],

  "ltex.enabled": true,
  "ltex.enabledLanguageIds": [
    "latex",
    "bibtex"
  ],
  "ltex.disabledRules": {
    "en-US": [
      "ADVISE_VBG",
      "ANY_MORE",
      "COMMA_PARENTHESIS_WHITESPACE",
      "CONSEQUENCES_OF_FOR",
      "CYBER_COMPOUNDS",
      "EN_COMPOUNDS_EVER_INCREASING",
      "EN_COMPOUNDS_MACHINE_READABLE",
      "EN_COMPOUNDS_MULTI_FACTOR",
      "EN_COMPOUNDS_MULTI_VENDOR",
      "EN_COMPOUNDS_TWENTY_FIVE",
      "ENGLISH_WORD_REPEAT_BEGINNING_RULE",
      "INDEPENDENTLY_FROM_OF",
      "LARGE_NUMBER_OF",
      "MORFOLOGIK_RULE_EN_US",
      "POSSESSIVE_APOSTROPHE",
      "THE_PUNCT",
      "UPPERCASE_SENTENCE_START",
      "WHETHER"
    ]
  },

  "files.exclude": {
    "**/.venv": true,
    "**/build": false,
    "**/build/*": false,
    "**/extra": false,
    "**/markitdown": true,
    "**/*.aux": true,
    "**/*.bcf": true,
    "**/*.blg": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.toc": true,
    "**/chapters/chap-introduction - Copy.tex": true,
    "**/chapters/chap-conclusion.tex": true,
    "**/chapters/chap-design.tex": true,
    "**/chapters/chap-discussion.tex": true,
    "**/chapters/chap-implementation.tex": true,
    "**/chapters/chap-literature-review.tex": true,
    "**/usmthesis_original.tex": true,
    "**/extra md files": true
  },

  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "push",
  "git.confirmSync": false,
  "latex-workshop.formatting.latex": "latexindent",
  "cSpell.words": [
    "ECHONET"
  ],
  "ltex.dictionary": {
    "en-US": [
      "apa",
      "apacite",
      "biblatex"
    ]
  }
}